-- Toggle button draggable logic
local dragging = false
local dragOffset = Vector2.new(0, 0)

toggleButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		local mousePos = UserInputService:GetMouseLocation()
		local btnPos = toggleButton.AbsolutePosition
		dragOffset = Vector2.new(mousePos.X - btnPos.X, mousePos.Y - btnPos.Y)
		-- Slight scale up feedback
		tweenSize(toggleButton, UDim2.new(0, 55, 0, 55))
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local mousePos = UserInputService:GetMouseLocation()
		local newPos = Vector2.new(mousePos.X - dragOffset.X, mousePos.Y - dragOffset.Y)
		-- Clamp inside mainFrame
		local framePos = mainFrame.AbsolutePosition
		local frameSize = mainFrame.AbsoluteSize
		local halfSize = toggleButton.AbsoluteSize / 2
		newPos = Vector2.new(
			math.clamp(newPos.X, framePos.X + 10, framePos.X + frameSize.X - toggleButton.AbsoluteSize.X - 10),
			math.clamp(newPos.Y, framePos.Y + 40, framePos.Y + frameSize.Y - toggleButton.AbsoluteSize.Y - 10)
		)
		toggleButton.Position = UDim2.new(0, newPos.X - framePos.X, 0, newPos.Y - framePos.Y)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 and dragging then
		dragging = false
		tweenSize(toggleButton, UDim2.new(0, 50, 0, 50))
	end
end)

-- Helper function to tween size
function tweenSize(instance, targetSize)
	local tweenInfo = TweenInfo.new(0.15, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
	local tween = TweenService:Create(instance, tweenInfo, {Size = targetSize})
	tween:Play()
end

-- Make main window draggable by header
local headerDragging = false
local headerDragOffset = Vector2.new(0, 0)

header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		headerDragging = true
		local mousePos = UserInputService:GetMouseLocation()
		local framePos = mainFrame.AbsolutePosition
		headerDragOffset = Vector2.new(mousePos.X - framePos.X, mousePos.Y - framePos.Y)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if headerDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local mousePos = UserInputService:GetMouseLocation()
		local newPos = Vector2.new(mousePos.X - headerDragOffset.X, mousePos.Y - headerDragOffset.Y)
		-- Keep window within screen bounds
		local screenSize = workspace.CurrentCamera.ViewportSize
		newPos = Vector2.new(
			math.clamp(newPos.X, 0, screenSize.X - mainFrame.AbsoluteSize.X),
			math.clamp(newPos.Y, 0, screenSize.Y - mainFrame.AbsoluteSize.Y)
		)
		mainFrame.Position = UDim2.new(0, newPos.X, 0, newPos.Y)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 and headerDragging then
		headerDragging = false
	end
end)

