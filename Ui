-- Global Auto Farm Loop (Collects all crops without plot owner restrictions)
task.spawn(function()
    while task.wait(0.2) do
        if AutoFarm then
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Model") then
                    local parentName = obj.Parent and obj.Parent.Name or ""
                    if parentName == "Crops" or parentName == "Plants" or parentName == "Plots" or parentName:find("Garden") or parentName:find("Plot") or obj:FindFirstChild("Fruit") or obj:FindFirstChild("Crop") then
                        CollectCropRemote:FireServer({ obj })
                    end
                end
            end
        end
    end
end)

-- Auto Buy Seed Loop
task.spawn(function()
    while task.wait(0.5) do
        if AutoBuySeed and SelectedSeed ~= "" then
            local cleanSeedName = SelectedSeed:gsub(" Seed", "")
            BuySeedRemote:FireServer("Shop", cleanSeedName)
        end
    end
end)

