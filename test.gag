-- AutoFarm Script for Grow a Garden
-- This script will automatically farm for the user who runs it

-- Configuration
local farmInterval = 1 -- Time between farming attempts (in seconds)
local enabled = false   -- Whether the auto farm is active (starts disabled)

-- Create GUI button
local player = game.Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "AutoFarmGUI"
screenGui.ResetOnSpawn = false

local button = Instance.new("TextButton")
button.Name = "ToggleAutoFarm"
button.Size = UDim2.new(0, 150, 0, 50)
button.Position = UDim2.new(0, 10, 0, 10)
button.Text = "AutoFarm: OFF"
button.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.BorderSizePixel = 0
button.TextSize = 18
button.Parent = screenGui

-- Get the player's collect remote
local character = player.Character or player.CharacterAdded:Wait()
local backpack = player:WaitForChild("Backpack")
local collectRemote = nil

-- Function to find the collect remote in the backpack or character
local function findCollectRemote()
    for _, item in pairs(backpack:GetChildren()) do
        if item.Name == "Collect Remote" then
            return item
        end
    end
    
    -- Check if it's equipped
    local tool = character:FindFirstChildOfClass("Tool")
    if tool and tool.Name == "Collect Remote" then
        return tool
    end
    
    return nil
end

-- Function to perform the farming action
local function farm()
    if not enabled then return end
    
    collectRemote = findCollectRemote()
    
    if collectRemote then
        -- Activate the collect remote
        collectRemote:Activate()
        print("AutoFarm: Collected items")
    else
        print("AutoFarm: Collect Remote not found")
    end
end

-- Toggle function for the button
local function toggleAutoFarm()
    enabled = not enabled
    if enabled then
        button.Text = "AutoFarm: ON"
        button.BackgroundColor3 = Color3.fromRGB(100, 255, 100)
        print("AutoFarm enabled")
    else
        button.Text = "AutoFarm: OFF"
        button.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
        print("AutoFarm disabled")
    end
end

-- Connect button click event
button.MouseButton1Click:Connect(toggleAutoFarm)

-- Add GUI to player's screen
screenGui.Parent = playerGui

-- Main loop
print("AutoFarm loaded - Click the button to toggle")

while player.Parent ~= nil do
    if enabled then
        pcall(farm)
    end
    wait(farmInterval)
end

print("AutoFarm stopped")
