-- AutoFarm Script for Grow a Garden
-- This script will automatically farm for the user who runs it

-- Configuration
local farmInterval = 1 -- Time between farming attempts (in seconds)
local enabled = false   -- Whether the auto farm is active (starts disabled)

-- Create GUI button
local player = game.Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "AutoFarmGUI"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

local button = Instance.new("TextButton")
button.Name = "ToggleAutoFarm"
button.Size = UDim2.new(0, 150, 0, 50)
button.Position = UDim2.new(0, 10, 0, 10)
button.Text = "AutoFarm: OFF"
button.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.BorderSizePixel = 0
button.TextSize = 18
button.Parent = screenGui

-- Function to find and activate the collect remote
local function farm()
    if not enabled then return end
    
    local character = player.Character
    if not character then 
        warn("No character found")
        return 
    end
    
    local backpack = player:FindFirstChild("Backpack")
    if not backpack then 
        warn("No backpack found")
        return 
    end
    
    -- Search for Collect Remote in backpack
    local collectRemote = nil
    for _, item in pairs(backpack:GetChildren()) do
        if item:IsA("Tool") and item.Name == "Collect Remote" then
            collectRemote = item
            break
        end
    end
    
    -- If not in backpack, check if equipped
    if not collectRemote then
        for _, item in pairs(character:GetChildren()) do
            if item:IsA("Tool") and item.Name == "Collect Remote" then
                collectRemote = item
                break
            end
        end
    end
    
    if collectRemote then
        -- Check if the tool has an activate function or remote event
        if collectRemote:FindFirstChild("RemoteEvent") then
            collectRemote.RemoteEvent:FireServer()
            print("AutoFarm: Collected items using RemoteEvent")
        else
            -- Try to activate the tool directly
            collectRemote:Activate()
            print("AutoFarm: Collected items using Activate")
        end
    else
        print("AutoFarm: Collect Remote not found")
        -- Try to get it from ReplicatedStorage or other locations
        local replicatedStorage = game:GetService("ReplicatedStorage")
        if replicatedStorage then
            local remote = replicatedStorage:FindFirstChild("Collect Remote") or 
                          replicatedStorage:FindFirstChild("CollectRemote")
            if remote then
                print("Found remote in ReplicatedStorage but cannot use it directly")
            end
        end
    end
end

-- Toggle function for the button
local function toggleAutoFarm()
    enabled = not enabled
    if enabled then
        button.Text = "AutoFarm: ON"
        button.BackgroundColor3 = Color3.fromRGB(100, 255, 100)
        print("AutoFarm enabled")
    else
        button.Text = "AutoFarm: OFF"
        button.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
        print("AutoFarm disabled")
    end
end

-- Connect button click event
button.MouseButton1Click:Connect(toggleAutoFarm)

-- Add GUI to player's screen
pcall(function()
    screenGui.Parent = playerGui
end)

-- Main loop
print("AutoFarm loaded - Click the button to toggle")

-- Handle character loading
player.CharacterAdded:Connect(function(character)
    print("Character loaded")
end)

while player and player.Parent do
    pcall(function()
        if enabled then
            farm()
        end
    end)
    wait(farmInterval)
end

print("AutoFarm stopped")
